<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <permission android:name="dev.wonderdesk.vault.LOGINS" android:protectionLevel="signature" />
    <application android:enableOnBackInvokedCallback="true" android:label="Vault">
        <activity android:name=".MainActivity" android:exported="true" android:resizeableActivity="true" android:launchMode="singleTask">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".LoginPickActivity" android:exported="true" android:permission="dev.wonderdesk.vault.LOGINS" android:theme="@style/VaultSheet" android:windowSoftInputMode="adjustResize" android:excludeFromRecents="true" android:taskAffinity="dev.wonderdesk.vault.autofill" />
        <activity android:name=".AutofillPickActivity" android:exported="false" android:theme="@style/VaultSheet" android:windowSoftInputMode="adjustResize" android:excludeFromRecents="true" android:taskAffinity="dev.wonderdesk.vault.autofill" />
        <service android:name=".VaultAutofillService" android:exported="true" android:label="Vault" android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter><action android:name="android.service.autofill.AutofillService" /></intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/autofill_service" />
        </service>
        <activity android:name=".BridgeActivity" android:exported="true" android:excludeFromRecents="true" android:label="Vault">
            <intent-filter><action android:name="dev.wonderdesk.vault.PICK" /><action android:name="dev.wonderdesk.vault.SAVE" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity>
    </application>
</manifest>
